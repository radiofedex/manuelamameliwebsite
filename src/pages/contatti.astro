---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArcDivider from '../components/ArcDivider.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../data/site';

const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(SITE.address)}&output=embed`;
---

<BaseLayout
  title="Contatti e Prenotazioni | Dentista a Cagliari, Viale Armando Diaz"
  description="Contatta lo Studio Dentistico Manuela Mereu a Cagliari: indirizzo, telefono, orari e modulo di richiesta appuntamento."
>
  <section class="container page-hero" data-reveal>
    <p class="eyebrow">Contatti</p>
    <h1>Vieni a trovarci</h1>
    <p class="section-heading__lead">Siamo a tua disposizione per rispondere a ogni domanda e organizzare la tua visita.</p>
  </section>

  <section class="container contact-grid">
    <div class="contact-info" data-reveal>
      <ul class="contact-info__list">
        <li>
          <span class="contact-info__icon"><Icon name="pin" size={22} /></span>
          <div>
            <strong>Indirizzo</strong>
            <p>{SITE.address}</p>
          </div>
        </li>
        <li>
          <span class="contact-info__icon"><Icon name="clock" size={22} /></span>
          <div>
            <strong>Orari</strong>
            <p>{SITE.hours}</p>
          </div>
        </li>
        <li>
          <span class="contact-info__icon"><Icon name="parking" size={22} /></span>
          <div>
            <strong>Parcheggio</strong>
            <p>Ampio parcheggio disponibile in Piazza dei Centomila</p>
          </div>
        </li>
      </ul>

      <div class="contact-info__direct">
        <a class="pill-button pill-button--primary" href={SITE.phoneHref}>Chiama {SITE.phone}</a>
        <a class="pill-button pill-button--secondary" href={`${SITE.whatsapp}?text=${encodeURIComponent(SITE.whatsappMessage)}`}>Scrivici su WhatsApp</a>
        <a class="pill-button pill-button--ghost" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </div>
    </div>

    <div class="contact-map" data-reveal style="transition-delay:100ms">
      <iframe
        title="Mappa dello Studio Dentistico Manuela Mereu"
        src={mapSrc}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </section>

  <ArcDivider variant="smile" color="var(--cream-alt)" bg="var(--sand)" />

  <section class="form-section">
    <div class="container section-heading" data-reveal>
      <p class="eyebrow">Richiedi un appuntamento</p>
      <h2>Prenota la tua visita</h2>
      <p>Compila il modulo e ti risponderemo al più presto per confermare data e orario.</p>
    </div>
    <div class="container form-section__form" data-reveal style="transition-delay:100ms">
      <ContactForm />
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-block: var(--space-2xl) var(--space-lg);
    max-width: 40rem;
  }

  .section-heading__lead {
    font-size: var(--step-lead);
    color: var(--ink-soft);
  }

  .contact-grid {
    display: grid;
    gap: var(--space-xl);
    padding-bottom: var(--space-2xl);
  }

  .contact-info__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .contact-info__list li {
    display: flex;
    gap: var(--space-sm);
  }

  .contact-info__list p {
    margin: 0;
    color: var(--ink-soft);
  }

  .contact-info__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--teal) 14%, transparent);
    color: var(--teal-dark);
    flex-shrink: 0;
  }

  .contact-info__direct {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .contact-map iframe {
    width: 100%;
    height: 22rem;
    border: 0;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-soft);
  }

  @media (min-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr 1.1fr;
    }
  }

  .form-section {
    background: var(--cream-alt);
    padding-block: var(--space-xl) var(--space-2xl);
  }

  .form-section__form {
    max-width: 44rem;
  }
</style>
