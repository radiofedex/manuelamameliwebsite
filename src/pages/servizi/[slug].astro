---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArcDivider from '../../components/ArcDivider.astro';
import Icon from '../../components/Icon.astro';
import { SERVICE_IMAGES } from '../../data/service-images';
import { withBase } from '../../utils/url';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
const { title, metaDescription, intro, highlights, forWhom, whatToExpect, icon, accent } = service.data;
const image = SERVICE_IMAGES[service.id as keyof typeof SERVICE_IMAGES];
---

<BaseLayout title={`${title} a Cagliari | Studio Dentistico Manuela Mereu`} description={metaDescription}>
  <section class="service-hero" data-accent={accent}>
    <div class="container service-hero__grid">
      <div class="service-hero__copy">
        <p class="eyebrow">Trattamento</p>
        <h1>{title}</h1>
        <p class="service-hero__intro">{intro}</p>
        <div class="service-hero__actions">
          <a class="pill-button pill-button--primary" href={withBase('/contatti')}>Prenota una visita</a>
          <a class="pill-button pill-button--ghost" href={withBase('/servizi')}>&larr; Tutti i trattamenti</a>
        </div>
      </div>
      <div class="service-hero__stage" data-tilt-card>
        <span class="service-hero__photo">
          <Image src={image.src} alt={image.alt} width={480} height={420} loading="eager" />
        </span>
        <span class="service-hero__badge" aria-hidden="true"><Icon name={icon} size={30} /></span>
      </div>
    </div>
  </section>

  <ArcDivider variant="smile" color="var(--sand)" bg="var(--cream-alt)" />

  <section class="container service-body">
    <div class="service-body__block" data-reveal>
      <h2>Cosa comprende</h2>
      <ul class="check-list">
        {highlights.map((item: string) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>

    <div class="service-body__block" data-reveal>
      <h2>Per chi è indicato</h2>
      <p>{forWhom}</p>
    </div>

    <div class="service-body__block" data-reveal>
      <h2>Cosa aspettarsi</h2>
      <p>{whatToExpect}</p>
    </div>
  </section>

  <ArcDivider variant="terrace" flip color="var(--teal)" bg="var(--sand)" />

  <section class="cta-band">
    <div class="container cta-band__inner" data-reveal>
      <h2>Parliamone insieme</h2>
      <p>Prenota una visita per valutare il percorso più adatto a te, senza impegno.</p>
      <div class="cta-band__actions">
        <a class="pill-button pill-button--primary" href={withBase('/contatti')}>Prenota una visita</a>
        <a class="pill-button pill-button--secondary" href="https://wa.me/393792938759">Scrivici su WhatsApp</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .service-hero {
    position: relative;
    padding-block: var(--space-2xl) var(--space-xl);
    overflow: hidden;
  }

  .service-hero[data-accent='teal'] {
    --hero-accent: var(--teal);
  }

  .service-hero[data-accent='clay'] {
    --hero-accent: var(--clay);
  }

  .service-hero__grid {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  .service-hero__copy {
    max-width: 34rem;
  }

  .service-hero__intro {
    font-size: var(--step-lead);
    color: var(--ink-soft);
  }

  .service-hero__actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-top: var(--space-md);
  }

  .service-hero__stage {
    position: relative;
    perspective: 900px;
    justify-self: center;
  }

  .service-hero__photo {
    display: block;
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: var(--shadow-lift);
    transform: rotateX(calc(var(--tilt-y, 0) * -1deg)) rotateY(calc(var(--tilt-x, 0) * 1deg));
    transition: transform 550ms var(--ease-standard);
    will-change: transform;
  }

  .service-hero__photo img {
    width: 100%;
    max-width: 22rem;
    aspect-ratio: 8/7;
    object-fit: cover;
    display: block;
  }

  .service-hero__badge {
    position: absolute;
    right: -1rem;
    bottom: -1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.75rem;
    height: 3.75rem;
    border-radius: 50%;
    background: var(--hero-accent);
    color: var(--white);
    box-shadow: var(--shadow-soft);
    transform: translate3d(calc(var(--tilt-x, 0) * 1px), calc(var(--tilt-y, 0) * 1px), 0);
    transition: transform 550ms var(--ease-standard);
  }

  @media (min-width: 900px) {
    .service-hero__grid {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-hero__photo,
    .service-hero__badge {
      transition: none;
    }
  }

  .service-body {
    display: grid;
    gap: var(--space-lg);
    padding-block: var(--space-xl);
    background: var(--cream-alt);
  }

  @media (min-width: 900px) {
    .service-body {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .service-body__block h2 {
    font-size: var(--step-h3);
  }

  .check-list {
    list-style: none;
    display: grid;
    gap: var(--space-xs);
  }

  .check-list li {
    position: relative;
    padding-left: 1.6rem;
    color: var(--ink-soft);
  }

  .check-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--teal);
  }

  .cta-band {
    background: var(--sand);
    padding-block: var(--space-xl) var(--space-2xl);
    text-align: center;
  }

  .cta-band__inner {
    max-width: 34rem;
    margin-inline: auto;
  }

  .cta-band__actions {
    display: flex;
    justify-content: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-top: var(--space-md);
  }
</style>
