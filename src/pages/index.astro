---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArcDivider from '../components/ArcDivider.astro';
import ServiceCard from '../components/ServiceCard.astro';
import PhotoMarquee from '../components/PhotoMarquee.astro';
import SignatureWrite from '../components/SignatureWrite.astro';
import { SERVICE_IMAGES } from '../data/service-images';
import { withBase } from '../utils/url';
import heroPortrait from '../assets/images/team/manuela-mereu-ritratto-chiaro.png';
import atWork from '../assets/images/team/manuela-mereu-al-lavoro.jpg';
import signature from '../assets/images/team/manuela-mereu-firma.png';
import salaAttesa from '../assets/images/studio/sala-attesa.jpg';
import esterno from '../assets/images/studio/esterno-edificio.jpg';
import ingresso from '../assets/images/studio/ingresso.jpg';
import attrezzature from '../assets/images/studio/attrezzature.jpg';
import riunito from '../assets/images/studio/riunito-odontoiatrico.jpg';
import salaColloquio from '../assets/images/studio/sala-colloquio.jpg';
import salaAttesaAlt from '../assets/images/studio/sala-attesa-alt.jpg';
import visitaPediatrica from '../assets/images/studio/visita-pediatrica.jpg';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

const studioPhotos = [
  { src: esterno, alt: 'Facciata dell’edificio dello Studio Dentistico Manuela Mereu' },
  { src: ingresso, alt: 'Ingresso dello Studio Dentistico Manuela Mereu' },
  { src: salaAttesa, alt: 'Sala d’attesa dello studio, luminosa e accogliente' },
  { src: attrezzature, alt: 'Attrezzature odontoiatriche moderne dello studio' },
  { src: riunito, alt: 'Riunito odontoiatrico in una delle sale operative' },
  { src: visitaPediatrica, alt: 'Visita pediatrica in studio' },
  { src: salaColloquio, alt: 'Sala colloqui per il confronto con i pazienti' },
  { src: salaAttesaAlt, alt: 'Dettaglio della sala d’attesa' },
];

const badges = [
  { label: '22 anni', sub: 'di esperienza a Cagliari' },
  { label: 'Parcheggio', sub: 'ampio, in Piazza dei Centomila' },
  { label: 'Accessibile', sub: 'nessuna barriera architettonica' },
  { label: 'Ambiente', sub: 'moderno e accogliente' },
];
---

<BaseLayout
  title="Studio Dentistico Manuela Mereu | Dentista a Cagliari"
  description="Studio dentistico a Cagliari in Viale Armando Diaz 30. 22 anni di esperienza, spazio moderno e accogliente, ampio parcheggio. Prenota la tua visita."
>
  <section class="hero">
    <div class="hero__copy" data-reveal>
      <p class="eyebrow">Studio Dentistico a Cagliari</p>
      <SignatureWrite text="Manuela Mereu" />
      <h1>Il tuo sorriso, a Cagliari, in mani esperte da 22 anni.</h1>
      <p class="hero__lead">Cura odontoiatrica moderna e su misura, in uno spazio pensato per farti sentire a tuo agio, dalla prima visita al sorriso che desideri.</p>
      <div class="hero__actions">
        <a class="pill-button pill-button--primary" href={withBase('/contatti')}>Prenota una visita</a>
        <a class="pill-button pill-button--secondary" href="https://wa.me/393792938759">Scrivici su WhatsApp</a>
      </div>
    </div>
    <div class="hero__media" data-reveal style="transition-delay:120ms">
      <Image src={heroPortrait} alt="Dott.ssa Manuela Mereu, Studio Dentistico a Cagliari" width={760} height={900} loading="eager" fetchpriority="high" />
      <span class="hero__media-fade" aria-hidden="true"></span>
    </div>
  </section>

  <section class="stats-band">
    <div class="container stats-band__head" data-reveal>
      <p class="eyebrow eyebrow--light">Perch&eacute; sceglierci</p>
      <h2>22 anni di fiducia, un solo studio</h2>
    </div>
    <div class="container stats-band__grid">
      {badges.map((badge, i) => (
        <div class="stat" data-reveal style={`transition-delay:${i * 110}ms`}>
          <span class="stat__index">{String(i + 1).padStart(2, '0')}</span>
          <strong class="stat__label">{badge.label}</strong>
          <span class="stat__sub">{badge.sub}</span>
        </div>
      ))}
    </div>
  </section>

  <ArcDivider variant="smile" color="var(--sand)" bg="var(--teal-forest)" />

  <section class="studio-marquee" data-reveal>
    <div class="container">
      <p class="studio-marquee__label eyebrow">Uno sguardo sullo studio</p>
    </div>
    <PhotoMarquee photos={studioPhotos} />
  </section>

  <section class="container intro-doctor">
    <div class="intro-doctor__media" data-reveal>
      <span class="intro-doctor__glow" aria-hidden="true"></span>
      <Image src={atWork} alt="Dott.ssa Manuela Mereu al lavoro nello studio" width={420} height={420} />
      <Image src={signature} alt="Firma di Manuela Mereu" width={150} height={40} class="intro-doctor__signature" />
    </div>
    <div class="intro-doctor__copy" data-reveal style="transition-delay:100ms">
      <p class="eyebrow">Chi si prende cura di te</p>
      <h2>Un rapporto di fiducia, prima ancora che una cura</h2>
      <p>Da 22 anni la Dott.ssa Manuela Mereu segue i suoi pazienti a Cagliari con un approccio attento e personale, in uno studio pensato per mettere a proprio agio chiunque vi entri.</p>
      <a class="pill-button pill-button--ghost" href={withBase('/chi-siamo')}>Scopri lo studio</a>
    </div>
  </section>

  <ArcDivider variant="terrace" color="var(--teal-light)" bg="var(--sand)" />

  <section class="services-teaser">
    <div class="container section-heading" data-reveal>
      <p class="eyebrow">I nostri trattamenti</p>
      <h2>Dalla prevenzione all'estetica</h2>
      <p>Un percorso di cura pensato per ogni esigenza. Scorri per scoprirli tutti.</p>
    </div>
    <div class="services-teaser__rail" data-reveal>
      {services.map((service) => (
        <div class="services-teaser__item">
          <ServiceCard
            title={service.data.title}
            shortDescription={service.data.shortDescription}
            href={withBase(`/servizi/${service.id}`)}
            icon={service.data.icon}
            accent={service.data.accent}
            image={SERVICE_IMAGES[service.id as keyof typeof SERVICE_IMAGES].src}
            imageAlt={SERVICE_IMAGES[service.id as keyof typeof SERVICE_IMAGES].alt}
          />
        </div>
      ))}
    </div>
    <div class="container services-teaser__more">
      <a class="pill-button pill-button--ghost" href={withBase('/servizi')}>Vedi tutti i trattamenti</a>
    </div>
  </section>

  <section class="closing-cta">
    <Image class="closing-cta__bg" src={salaAttesa} alt="" width={1600} height={700} aria-hidden="true" />
    <div class="closing-cta__overlay"></div>
    <div class="container closing-cta__inner" data-reveal>
      <h2>Prenota la tua visita</h2>
      <p>{`Viale Armando Diaz, 30, Cagliari · Lun–Ven 09:00–20:00`}</p>
      <div class="closing-cta__actions">
        <a class="pill-button pill-button--primary" href={withBase('/contatti')}>Prenota una visita</a>
        <a class="pill-button pill-button--ghost" href="tel:+393792938759">Chiama lo studio</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    align-items: stretch;
    min-height: 80vh;
    min-height: 80svh;
    background: var(--sand);
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-2xs);
    padding: var(--space-2xl) var(--space-md) var(--space-xl) max(1.25rem, calc((100vw - var(--container-max)) / 2 + 1.25rem));
  }

  .hero__copy h1 {
    color: var(--ink);
    margin-top: var(--space-sm);
  }

  .hero__lead {
    font-size: var(--step-lead);
    color: var(--ink-soft);
    max-width: 32rem;
  }

  .hero__actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-top: var(--space-md);
  }

  .hero__media {
    position: relative;
    min-height: 20rem;
  }

  .hero__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 40% 10%;
  }

  .hero__media-fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--sand) 0%, transparent 14%);
    pointer-events: none;
  }

  .stats-band {
    background: var(--teal-forest);
    padding-block: var(--space-xl);
  }

  .stats-band__head {
    max-width: none;
    margin-bottom: var(--space-lg);
  }

  @media (min-width: 640px) {
    .stats-band__head h2 {
      white-space: nowrap;
    }
  }

  .stats-band__head h2 {
    color: var(--white);
    margin: 0;
  }

  .stats-band .eyebrow--light {
    margin-bottom: var(--space-sm);
  }

  .stats-band__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-top: var(--space-sm);
    border-top: 2px solid color-mix(in srgb, var(--teal) 45%, transparent);
  }

  .stat__index {
    font-family: var(--font-label);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    color: var(--teal-light);
  }

  .stat__label {
    font-family: var(--font-display);
    font-size: var(--step-h3);
    font-weight: 600;
    line-height: 1.1;
    color: var(--white);
  }

  .stat__sub {
    font-size: 0.85rem;
    color: color-mix(in srgb, var(--white) 68%, transparent);
  }

  @media (min-width: 700px) {
    .stats-band__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 1.6fr 0.4fr;
    }
  }

  @media (max-width: 899px) {
    .hero__copy {
      padding-inline: var(--space-md);
    }
  }

  .studio-marquee {
    padding-block: var(--space-lg) var(--space-xl);
  }

  .studio-marquee__label {
    margin-bottom: var(--space-sm);
  }

  .intro-doctor {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
    padding-block: var(--space-2xl);
  }

  .intro-doctor__media {
    position: relative;
    justify-self: center;
  }

  .intro-doctor__glow {
    position: absolute;
    inset: -2rem;
    background: var(--gradient-signature);
    filter: blur(44px);
    opacity: 0.28;
    border-radius: 50%;
    z-index: 0;
  }

  .intro-doctor__media img:first-of-type {
    position: relative;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-soft);
    object-fit: cover;
    width: 100%;
    max-width: 22rem;
    aspect-ratio: 1;
  }

  .intro-doctor__signature {
    position: absolute;
    right: -1rem;
    bottom: -1rem;
    height: 3.25rem;
    width: auto;
    padding: 0.6rem 0.9rem;
    background: var(--white);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-soft);
  }

  @media (min-width: 900px) {
    .intro-doctor {
      grid-template-columns: 0.8fr 1.2fr;
    }
  }

  .services-teaser {
    background: var(--teal-light);
    color: var(--ink);
    padding-block: var(--space-2xl);
  }

  .services-teaser h2 {
    color: var(--ink);
  }

  .services-teaser .section-heading p {
    color: var(--ink-soft);
  }

  .eyebrow--light {
    color: var(--teal-light);
  }

  .services-teaser__rail {
    display: flex;
    gap: var(--space-md);
    overflow-x: auto;
    padding: 0 max(1.25rem, calc((100vw - var(--container-max)) / 2 + 1.25rem)) var(--space-md);
    scroll-snap-type: x proximity;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent);
  }

  .services-teaser__item {
    flex: 0 0 auto;
    width: 19rem;
    scroll-snap-align: start;
  }

  .services-teaser__more {
    display: flex;
    justify-content: center;
    margin-top: var(--space-sm);
  }

  .services-teaser__more .pill-button--ghost {
    background: var(--cream-alt);
    border-color: color-mix(in srgb, var(--teal-dark) 25%, transparent);
    color: var(--teal-dark);
  }

  .services-teaser__more .pill-button--ghost:hover {
    background: var(--teal-dark);
    color: var(--white);
  }

  .closing-cta {
    position: relative;
    padding-block: var(--space-2xl);
    overflow: hidden;
    isolation: isolate;
  }

  .closing-cta__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  .closing-cta__overlay {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--ink) 82%, transparent);
    z-index: -1;
  }

  .closing-cta__inner {
    text-align: center;
    color: var(--sand);
    max-width: 34rem;
    margin-inline: auto;
  }

  .closing-cta__inner h2 {
    color: var(--sand);
  }

  .closing-cta__actions {
    display: flex;
    justify-content: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-top: var(--space-md);
  }
</style>
