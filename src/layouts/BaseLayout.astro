---
import { ClientRouter } from 'astro:transitions';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { withBase } from '../utils/url';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  transparentHeader?: boolean;
}

const { title, description, image, transparentHeader = false } = Astro.props;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32.png')} />
    <link rel="icon" type="image/png" sizes="512x512" href={withBase('/favicon-512.png')} />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <meta name="generator" content={Astro.generator} />
    <Seo title={title} description={description} image={image} />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Vai al contenuto</a>
    <Header transparentOnTop={transparentHeader} />
    <main id="main" class:list={{ 'main--offset': !transparentHeader }}>
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
    <CookieBanner />
    <script src="../scripts/reveal.ts"></script>
    <script src="../scripts/tilt.ts"></script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: -999px;
    top: 0;
    background: var(--ink);
    color: var(--sand);
    padding: 0.75rem 1.25rem;
    z-index: 100;
    border-radius: 0 0 8px 0;
  }

  .skip-link:focus {
    left: 0;
  }
</style>
